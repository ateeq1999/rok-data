//! The client's runtime: [`Client`], the session it keeps, [`ApiError`]
//! and the one request every call goes through.

use std::collections::BTreeMap;
use std::fmt;
use std::sync::{Arc, PoisonError, RwLock};

use reqwest::header::{HeaderMap, HeaderName, HeaderValue};
use reqwest::{Method, StatusCode};
use serde::de::DeserializeOwned;
use serde::{Deserialize, Deserializer, Serialize};

/// A broken validation rule of one field, as the API reports it.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct FieldIssue {
    /// The rule, such as `length`.
    pub code: String,
    /// A message for people.
    pub message: String,
    /// The rule's parameters, such as `{"min": 8}`.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub params: Option<serde_json::Map<String, serde_json::Value>>,
}

/// The broken rules of a rejected body, by field path.
pub type FieldDetails = BTreeMap<String, Vec<FieldIssue>>;

/// Any answer that is not a success, and a request that never reached the
/// API (`status` 0, `code` `network_error`) or whose answer could not be
/// read (`code` `decode_error`). A `422`'s `details` holds the broken rules
/// by field.
#[derive(Debug)]
pub struct ApiError {
    /// The answer's status, or 0 when there was none.
    pub status: u16,
    /// The wire standard's `snake_case` code, such as `validation_failed`.
    pub code: String,
    /// A message for people.
    pub message: String,
    /// The broken rules by field, when the API reported any.
    pub details: Option<FieldDetails>,
    source: Option<reqwest::Error>,
}

impl ApiError {
    fn new(status: u16, code: &str, message: impl Into<String>) -> ApiError {
        ApiError {
            status,
            code: code.to_owned(),
            message: message.into(),
            details: None,
            source: None,
        }
    }

    fn network(source: reqwest::Error) -> ApiError {
        ApiError {
            source: Some(source),
            ..ApiError::new(0, "network_error", "Cannot reach the server")
        }
    }

    fn decode(status: StatusCode, source: reqwest::Error) -> ApiError {
        ApiError {
            source: Some(source),
            ..ApiError::new(
                status.as_u16(),
                "decode_error",
                "The answer is not what the API documents",
            )
        }
    }

    /// The broken rules of the field `path`, if any.
    pub fn field(&self, path: &str) -> &[FieldIssue] {
        self.details
            .as_ref()
            .and_then(|details| details.get(path))
            .map_or(&[], Vec::as_slice)
    }

    /// The error answer `status` with its `body`, in the wire standard's
    /// shape (`{"error": {"code", "message", "details"?}}`) or not.
    fn answered(status: StatusCode, body: &[u8]) -> ApiError {
        #[derive(Deserialize)]
        struct Body {
            error: Payload,
        }
        #[derive(Deserialize)]
        struct Payload {
            code: Option<String>,
            message: Option<String>,
            details: Option<FieldDetails>,
        }
        let payload = serde_json::from_slice::<Body>(body)
            .ok()
            .map(|body| body.error);
        let fallback = match status {
            StatusCode::PAYLOAD_TOO_LARGE => "The file is too large.",
            StatusCode::UNSUPPORTED_MEDIA_TYPE => "That file type is not supported.",
            _ => status.canonical_reason().unwrap_or("Request failed"),
        };
        let (code, message, details) = match payload {
            Some(payload) => (payload.code, payload.message, payload.details),
            None => (None, None, None),
        };
        ApiError {
            details,
            ..ApiError::new(
                status.as_u16(),
                code.as_deref().unwrap_or("unknown"),
                message.unwrap_or_else(|| fallback.to_owned()),
            )
        }
    }
}

impl fmt::Display for ApiError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        if self.status == 0 {
            write!(f, "{} ({})", self.message, self.code)
        } else {
            write!(f, "{} ({} {})", self.message, self.status, self.code)
        }
    }
}

impl std::error::Error for ApiError {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        self.source
            .as_ref()
            .map(|source| source as &(dyn std::error::Error + 'static))
    }
}

/// What a rejected session token does: see [`Client::on_unauthorized`].
type Unauthorized = Arc<dyn Fn(&str) + Send + Sync>;

/// The API's client: its address, the session's bearer token and the
/// headers every call sends. Cloning it is cheap, and clones share the
/// session: set the token once, after signing in, and every clone sends it.
#[derive(Clone)]
pub struct Client {
    http: reqwest::Client,
    base_url: Arc<str>,
    token: Arc<RwLock<Option<String>>>,
    headers: HeaderMap,
    on_unauthorized: Option<Unauthorized>,
    keep_session: bool,
}

impl fmt::Debug for Client {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_struct("Client")
            .field("base_url", &self.base_url)
            .field("signed_in", &self.token().is_some())
            .field("keep_session", &self.keep_session)
            .finish_non_exhaustive()
    }
}

impl Client {
    /// A client of the API at `base_url`, its origin (such as
    /// `http://127.0.0.1:8080`), with no session.
    pub fn new(base_url: impl Into<String>) -> Client {
        Client::with_http(reqwest::Client::new(), base_url)
    }

    /// A client of the API at `base_url` over `http`, a `reqwest` client
    /// configured as the caller needs (timeouts, proxies, TLS).
    pub fn with_http(http: reqwest::Client, base_url: impl Into<String>) -> Client {
        Client {
            http,
            base_url: Arc::from(base_url.into()),
            token: Arc::default(),
            headers: HeaderMap::new(),
            on_unauthorized: None,
            keep_session: false,
        }
    }

    /// The API's origin, as given.
    pub fn base_url(&self) -> &str {
        &self.base_url
    }

    /// `path` on the API's origin: for a URL the API answers with, such as
    /// a profile photo's.
    pub fn api_url(&self, path: &str) -> String {
        format!("{}{path}", self.base_url.trim_end_matches('/'))
    }

    /// The session's bearer token, if signed in.
    pub fn token(&self) -> Option<String> {
        self.token
            .read()
            .unwrap_or_else(PoisonError::into_inner)
            .clone()
    }

    /// Sets the session's bearer token (`None` signs out), for this client
    /// and every clone of it. Only the operations the API secures send it.
    pub fn set_token(&self, token: Option<String>) {
        *self.token.write().unwrap_or_else(PoisonError::into_inner) = token;
    }

    /// Calls `handler` with the token the API rejected: a `401` to an
    /// operation that sent the session's token means the session is over.
    pub fn on_unauthorized(mut self, handler: impl Fn(&str) + Send + Sync + 'static) -> Client {
        self.on_unauthorized = Some(Arc::new(handler));
        self
    }

    /// This client, for calls whose `401` is an answer (a wrong password
    /// or code), not an expired session: the `on_unauthorized` handler is
    /// not called.
    pub fn keep_session(&self) -> Client {
        Client {
            keep_session: true,
            ..self.clone()
        }
    }

    /// This client, also sending the header `name: value` with every call
    /// (an `X-API-Key`, say).
    pub fn with_header(&self, name: HeaderName, value: HeaderValue) -> Client {
        let mut client = self.clone();
        client.headers.insert(name, value);
        client
    }

    /// A request of `method` to `path` (its parameters encoded with
    /// [`segment`]), with the session's token when `secured`.
    #[doc(hidden)]
    pub fn call(&self, method: Method, path: &str, secured: bool) -> Result<Call, ApiError> {
        let url = self.api_url(path);
        let url = reqwest::Url::parse(&url)
            .map_err(|err| ApiError::new(0, "invalid_url", format!("{url}: {err}")))?;
        let token = if secured { self.token() } else { None };
        let mut builder = self.http.request(method, url).headers(self.headers.clone());
        if let Some(token) = &token {
            builder = builder.bearer_auth(token);
        }
        Ok(Call {
            builder,
            typed: self.headers.contains_key(reqwest::header::CONTENT_TYPE),
            token,
            on_unauthorized: if self.keep_session {
                None
            } else {
                self.on_unauthorized.clone()
            },
        })
    }
}

/// One request on its way: what the generated operations build.
#[doc(hidden)]
pub struct Call {
    builder: reqwest::RequestBuilder,
    /// Whether the client's headers give the body's type.
    typed: bool,
    token: Option<String>,
    on_unauthorized: Option<Unauthorized>,
}

impl Call {
    /// Adds the query `query`.
    pub fn query<Q: Serialize + ?Sized>(mut self, query: &Q) -> Call {
        self.builder = self.builder.query(query);
        self
    }

    /// Sends `body` as JSON.
    pub fn json<B: Serialize + ?Sized>(mut self, body: &B) -> Call {
        self.builder = self.builder.json(body);
        self
    }

    /// Sends `body` as raw bytes, of the type the client's headers give
    /// (`application/octet-stream` when they give none).
    pub fn bytes(mut self, body: impl Into<reqwest::Body>) -> Call {
        if !self.typed {
            self.builder = self
                .builder
                .header(reqwest::header::CONTENT_TYPE, "application/octet-stream");
        }
        self.builder = self.builder.body(body);
        self
    }

    /// Sends the request; a success's answer, or the error.
    async fn send(self) -> Result<reqwest::Response, ApiError> {
        let response = self.builder.send().await.map_err(ApiError::network)?;
        let status = response.status();
        if status.is_success() {
            return Ok(response);
        }
        let body = response.bytes().await.unwrap_or_default();
        // Only a 401 for the token this call sent says the session is over.
        if status == StatusCode::UNAUTHORIZED
            && let (Some(token), Some(handler)) = (&self.token, &self.on_unauthorized)
        {
            handler(token);
        }
        Err(ApiError::answered(status, &body))
    }

    /// Sends the request; its success's JSON body.
    pub async fn json_answer<T: DeserializeOwned>(self) -> Result<T, ApiError> {
        let response = self.send().await?;
        let status = response.status();
        response
            .json()
            .await
            .map_err(|err| ApiError::decode(status, err))
    }

    /// Sends the request; its success's body, as bytes.
    pub async fn bytes_answer(self) -> Result<Vec<u8>, ApiError> {
        let response = self.send().await?;
        let status = response.status();
        response
            .bytes()
            .await
            .map(|bytes| bytes.to_vec())
            .map_err(|err| ApiError::decode(status, err))
    }

    /// Sends the request; its success has no body worth reading.
    pub async fn empty_answer(self) -> Result<(), ApiError> {
        self.send().await.map(drop)
    }
}

/// `value` as one path segment: every byte but the unreserved ones
/// (`A-Z a-z 0-9 - . _ ~`) percent-encoded.
#[doc(hidden)]
pub fn segment(value: &str) -> String {
    let mut out = String::with_capacity(value.len());
    for byte in value.bytes() {
        if byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'.' | b'_' | b'~') {
            out.push(char::from(byte));
        } else {
            out.push_str(&format!("%{byte:02X}"));
        }
    }
    out
}

/// Reads a property that may be absent (`None`), `null` (`Some(None)`) or
/// a value (`Some(Some(value))`).
#[doc(hidden)]
pub fn nullable<'de, D, T>(deserializer: D) -> Result<Option<Option<T>>, D::Error>
where
    D: Deserializer<'de>,
    T: Deserialize<'de>,
{
    Option::<T>::deserialize(deserializer).map(Some)
}
