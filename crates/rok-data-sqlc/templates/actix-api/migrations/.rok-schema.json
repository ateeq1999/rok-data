      "up": "CREATE FUNCTION touch_updated_at() RETURNS trigger\nLANGUAGE plpgsql AS $$\nbegin\n  new.updated_at := now();\n  return new;\nend;\n$$",
      "down": "DROP FUNCTION touch_updated_at()"
    },
    {
      "up": "CREATE TRIGGER users_touch_updated_at BEFORE UPDATE ON users\n    FOR EACH ROW EXECUTE FUNCTION touch_updated_at()",
      "down": "DROP TRIGGER users_touch_updated_at ON users"
    },
    {
      "up": "CREATE TRIGGER outbound_mail_touch_updated_at BEFORE UPDATE ON outbound_mail\n    FOR EACH ROW EXECUTE FUNCTION touch_updated_at()",
