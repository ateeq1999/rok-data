    {
      "name": "auth_tokens",
      "module": "types",
      "doc": [
        "Single-use tokens mailed as links. Only the SHA-256 of the token is",
        "kept; `used_at` spends it, and issuing a new one for the same user and",
        "purpose invalidates the older ones."
      ],
      "columns": [
        {
          "name": "id",
          "sql_type": "UUID",
          "nullable": false
        },
        {
          "name": "user_id",
          "sql_type": "UUID",
          "nullable": false
        },
        {
          "name": "purpose",
          "sql_type": "TEXT",
          "nullable": false
        },
        {
          "name": "token_hash",
          "sql_type": "TEXT",
          "nullable": false
        },
        {
          "name": "new_email",
          "sql_type": "TEXT",
          "nullable": true,
          "doc": [
            "The address an `email_change` token moves the account to."
          ]
        },
        {
          "name": "expires_at",
          "sql_type": "TIMESTAMPTZ",
          "nullable": false
        },
        {
          "name": "used_at",
          "sql_type": "TIMESTAMPTZ",
          "nullable": true
        },
        {
          "name": "created_at",
          "sql_type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      ],
      "primary_key": [
        "id"
      ],
      "uniques": [
        {
          "name": "auth_tokens_token_hash_key",
          "columns": [
            "token_hash"
          ]
        }
      ],
      "foreign_keys": [
        {
          "name": "auth_tokens_user_id_fkey",
          "columns": [
            "user_id"
          ],
          "ref_table": "users",
          "ref_columns": [
            "id"
          ],
          "on_delete": "CASCADE"
        }
      ],
      "checks": [
        {
          "name": "auth_tokens_purpose_check",
          "expr": "purpose IN ('email_verification', 'password_reset', 'email_change', 'invitation', 'two_factor_pending')"
        }
      ]
    },
    {
      "name": "outbound_mail",
      "module": "types",
      "doc": [
        "The mail outbox: a row is written on the flow's transaction and deleted",
        "once sent. A row that keeps failing becomes `dead`, keeping its error."
      ],
      "columns": [
        {
          "name": "id",
          "sql_type": "UUID",
          "nullable": false
        },
        {
          "name": "payload",
          "sql_type": "JSONB",
          "nullable": false
        },
        {
          "name": "status",
          "sql_type": "TEXT",
          "nullable": false,
          "default": "'pending'"
        },
        {
          "name": "attempts",
          "sql_type": "INTEGER",
          "nullable": false,
          "default": "0"
        },
        {
          "name": "next_attempt_at",
          "sql_type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "last_error",
          "sql_type": "TEXT",
          "nullable": true
        },
        {
          "name": "created_at",
          "sql_type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "updated_at",
          "sql_type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      ],
      "primary_key": [
        "id"
      ],
      "checks": [
        {
          "name": "outbound_mail_status_check",
          "expr": "status IN ('pending', 'dead')"
        }
      ]
    },
