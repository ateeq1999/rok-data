[package]
name = "desktop"
version = "0.1.0"
edition = "2021"

# rok-ui and gpui stay at the versions `cargo rok-ui new --template bloc --http`
# (rok-ui 0.9.1) generated this App with (workspace ADR 0031).
[dependencies]
# Its `http` feature for `ApiError` (what blocs and forms read) and
# `Session`; the requests themselves go through `api-client`.
rok-ui = { version = "=0.9.1", features = ["router", "bloc", "http", "form", "typography", "empty"] }
gpui = "=0.2.2"
# The API's client, generated from its contract (`clients/rust`): a change
# `rok gen` regenerates there breaks or flows through this App's build.
api-client = { path = "../../clients/rust" }
# The session's token, kept in the OS keychain between launches
# (`src/data/providers/token_store.rs`). On Linux it is the kernel keyring,
# which needs no system library but forgets the token when the machine restarts.
keyring = { version = "3", default-features = false, features = ["windows-native", "apple-native", "linux-native"] }

[dev-dependencies]
gpui = { version = "=0.2.2", features = ["test-support"] }
# The repositories' tests answer the client from a mock API on localhost.
rok-ui = { version = "=0.9.1", features = ["http-testing"] }
serde_json = "1"

[build-dependencies]
rok-ui-build = { version = "=0.9.1" }

[lints.rust]
missing_docs = "warn"

[lints.clippy]
pedantic = { level = "warn", priority = -1 }
# Event handlers match every event, often with the same body.
match_same_arms = "allow"
# GPUI is allowed in the app and denied again in each `features/<f>/bloc.rs`: see clippy.toml.
disallowed_types = "allow"
