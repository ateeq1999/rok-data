# Build-time settings: copy to `.env`, then
#   flutter run --dart-define-from-file=.env
# (they are compiled in; nothing here is a secret the App could keep).

# The API's origin. Unset: apps/api on this machine, http://127.0.0.1:8080
# (http://10.0.2.2:8080 from an Android emulator). A phone on the network
# needs the machine's address, and apps/api bound to it (BIND_ADDR).
API_URL=

# App Deep Link Scheme (<scheme>://auth/verify-email?token=...)
APP_SCHEME=myapp

# Feature Flags (true/false; absent = true)
FEATURE_TWO_FACTOR=true
FEATURE_SIGN_UP=true
FEATURE_THEME_CUSTOMIZATION=true
