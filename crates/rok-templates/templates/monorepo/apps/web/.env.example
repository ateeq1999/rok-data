# Leave empty in dev: the Vite proxy forwards /api and /health to the API.
# Also leave empty on Vercel: vercel.ts rewrites /api and /health to the
# deployed API origin, so the browser only ever talks to this same origin.
# Set VITE_API_URL only if you want the browser to call the API cross-origin
# instead (then the API's CORS_ALLOWED_ORIGINS must include this site).
VITE_API_URL=
# Dev proxy target (default http://127.0.0.1:8080, apps/api's BIND_ADDR)
# API_PROXY_TARGET=http://127.0.0.1:8080
