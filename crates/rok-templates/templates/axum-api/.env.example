# Copy to `.env` (or export these) and adjust. `src/config.rs` reads them;
# the application itself loads no `.env` file.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/actix_api
# At least 32 bytes; make one with `openssl rand -base64 48`:
JWT_SECRET=change-me-to-a-long-random-string
# Two-factor secrets are encrypted with it: 32 bytes in base64; make one with
# `openssl rand -base64 32`:
TOTP_ENCRYPTION_KEY=
BIND_ADDR=127.0.0.1:8080
# Serve /metrics (Prometheus) here, apart from the API (unset: no metrics):
# METRICS_ADDR=127.0.0.1:9090
# Seconds an issued token lasts (default 3600):
# JWT_TTL=3600
# The secret being rotated out: tokens it signed still pass until they expire.
# Set the new secret as JWT_SECRET and the old one here, wait one JWT_TTL,
# then remove it (at least 32 bytes):
# JWT_SECRET_PREVIOUS=
# Sign-in answers 403 until the email is verified (default true):
# REQUIRE_VERIFIED_EMAIL=true
# The base of the links mails carry, such as {APP_URL}/verify-email?token=...
# (default http://localhost:8080):
# APP_URL=http://localhost:8080
# How mail leaves: log (logged, not sent; the default; RUST_LOG=debug shows
# each body and its links) or smtp:
# MAIL_TRANSPORT=log
# Required when MAIL_TRANSPORT=smtp (smtps:// for TLS, or smtp://...?tls=required
# for STARTTLS):
# SMTP_URL=smtps://user:password@smtp.example.com:465
# The sender of every mail (default Axum API <no-reply@localhost>):
# MAIL_FROM=Axum API <no-reply@localhost>
# Reject passwords found in Have I Been Pwned's breaches (default false):
# BREACH_CHECK=false
# Take the client IP from X-Forwarded-For; only behind a proxy you run
# (default false):
# TRUST_PROXY=false
# Requests per minute per IP on /auth (default 20; 0 turns the limit off):
# AUTH_RATE_LIMIT=20
# Background jobs run at once; each holds a pool connection while it runs
# (default 4):
# JOBS_CONCURRENCY=4
# Requests per minute per IP on every route but /health (default 0: off):
# GLOBAL_RATE_LIMIT=0
# The other origins a browser may call the API from: * or a comma-separated
# list (default: none, the API's own origin only):
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
# Where uploads are stored: file://<dir> (default file://./storage), s3://<bucket>
# (with the AWS_* variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION,
# and AWS_ENDPOINT plus AWS_ALLOW_HTTP=true for MinIO) or memory://:
# STORAGE_URL=file://./storage
# The largest upload, in bytes (default 10485760, 10 MiB):
# MEDIA_MAX_UPLOAD_BYTES=10485760
# The types an upload may have, detected from its bytes:
# MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
# How long a direct upload URL is valid, in seconds (default 900):
# MEDIA_UPLOAD_URL_TTL_SECS=900
# How long a download URL is valid, in seconds (default 300):
# MEDIA_DOWNLOAD_URL_TTL_SECS=300
# How often uploads never completed are deleted, in seconds (default 300; 0
# turns the sweep off):
# MEDIA_UPLOAD_SWEEP_SECS=300
# The endpoint S3 URLs are signed for, when clients reach the store at another
# address than the API (http://localhost:9000 for MinIO in Docker):
# STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# Pool settings, all optional:
# DB_MAX_CONNECTIONS=20
# DB_MIN_CONNECTIONS=5
# DB_ACQUIRE_TIMEOUT_SECS=3
# DB_IDLE_TIMEOUT_SECS=600
# DB_MAX_LIFETIME_SECS=1800
# The log filter (default info), such as debug or info,sqlx=warn:
# RUST_LOG=info
# How log lines are written: pretty (readable; the default) or json (one
# object per line, for a log collector):
# LOG_FORMAT=pretty
# Export every span over OTLP/HTTP to this collector (unset: nothing is
# exported). The exporter reads the other standard OTEL_* variables itself,
# such as OTEL_EXPORTER_OTLP_HEADERS and OTEL_TRACES_SAMPLER:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# The service the spans belong to (default: the crate's name):
# OTEL_SERVICE_NAME=
