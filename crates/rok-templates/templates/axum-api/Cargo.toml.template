[package]
name = "axum-api"
version = "0.1.0"
edition = "2024"
rust-version = "1.94"
publish = false

# What the skeleton and the generated code need: `rok-data-sqlc.toml`'s hints and
# the generated `src/db/mod.rs`'s.
[dependencies]
aes-gcm = { version = "0.10", default-features = false, features = ["aes", "alloc"] }
argon2 = "0.6"
async-trait = "0.1"
axum = { version = "0.8", features = ["json", "macros", "query"] }
base64 = "0.22"
bytes = "1"
chrono = { version = "0.4", features = ["serde"] }
governor = { version = "0.10", default-features = false, features = ["std"] }
hmac = "0.13"
image = { version = "0.25", default-features = false, features = ["jpeg", "png", "webp"] }
infer = { version = "0.22", default-features = false }
jsonwebtoken = { version = "11", features = ["rust_crypto"] }
lettre = { version = "0.11", default-features = false, features = ["builder", "hostname", "smtp-transport", "tokio1-rustls-tls"] }
object_store = { version = "0.13", features = ["aws"] }
opentelemetry = { version = "0.32", default-features = false, features = ["trace"] }
opentelemetry-otlp = { version = "0.32", default-features = false, features = ["trace", "http-proto", "reqwest-blocking-client", "reqwest-rustls"] }
opentelemetry_sdk = { version = "0.32", default-features = false, features = ["trace"] }
qrcode = { version = "0.14", default-features = false, features = ["svg"] }
rand = "0.10"
reqwest = { version = "0.12", default-features = false, features = ["rustls-tls"] }
# The generated data layer's chains (`rok_data::Error`, the `Model` trait).
rok-data = { version = "0.4", features = ["chrono", "json", "uuid"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
# The axum extractor of the data layer names serde's path-aware error.
serde_path_to_error = "0.1"
sha1 = "0.11"
sha2 = "0.11"
sqlx = { version = "0.9", features = ["runtime-tokio", "postgres", "derive", "uuid", "chrono", "json"] }
subtle = "2"
thiserror = "2"
tokio = { version = "1", features = ["macros", "net", "rt", "rt-multi-thread", "signal", "sync", "time"] }
totp-rs = { version = "5", features = ["otpauth"] }
tower = { version = "0.5", features = ["util"] }
tower-http = { version = "0.6", features = ["catch-panic", "cors", "request-id", "timeout", "trace"] }
tracing = "0.1"
tracing-opentelemetry = { version = "0.33", default-features = false }
tracing-subscriber = { version = "0.3", features = ["env-filter", "json"] }
utoipa = { version = "5", features = ["chrono", "uuid"] }
utoipa-swagger-ui = { version = "9", features = ["axum", "vendored"] }
uuid = { version = "1", features = ["v7", "serde"] }
zeroize = "1"

# The test client: a request through the router, and its body.
[dev-dependencies]
http-body-util = "0.1"

[lints.rust]
unsafe_code = "forbid"

# The starters' strictness: no unwrap, expect or panic outside tests, and no
# leftover debugging.
[lints.clippy]
unwrap_used = "deny"
expect_used = "deny"
panic = "deny"
todo = "deny"
unimplemented = "deny"
dbg_macro = "deny"
print_stdout = "deny"

# The project is a workspace of its own: it never joins the one it was
# created in.
[workspace]
